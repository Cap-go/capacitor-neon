{
  "name": "@capgo/capacitor-neon",
  "version": "8.0.0",
  "description": "Native Neon Auth and Data API integration for Capacitor: Auth, Database, and JWT access",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapgoCapacitorNeon.podspec"
  ],
  "author": "Rishi Raj Jain <jain71000@gmail.com>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/capacitor-neon.git"
  },
  "bugs": {
    "url": "https://github.com/Cap-go/capacitor-neon/issues"
  },
  "homepage": "https://github.com/Cap-go/capacitor-neon#readme",
  "keywords": [
    "capacitor",
    "neon",
    "neon-auth",
    "better-auth",
    "postgres",
    "auth",
    "database",
    "jwt",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "bash scripts/verify-ios.sh",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint",
    "prettier": "prettier-pretty-check \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorNeonPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "bun run build",
    "check:wiring": "node scripts/check-capacitor-plugin-wiring.mjs",
    "check:cap9-deprecated": "bun scripts/check-cap9-deprecated.mjs",
    "prepare": "bun run build",
    "example:install": "cd example-app && bun install --frozen-lockfile",
    "example:build": "bun run build && cd example-app && bun install --frozen-lockfile && bun run build",
    "changelog:ai": "node scripts/generate-ai-changelog.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.5.3",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.12",
    "swiftlint": "^2.0.0",
    "typescript": "^6.0.3",
    "prettier-pretty-check": "^0.2.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
